# =============================================================================
#  Enterprise API Security Auditor - Agentic AI
#  Meta Global AI Developer Hackathon  |  Build for Your World
#
#  Single source of configuration. Loaded by absolute path from
#  backend/common/config.py, so every service picks it up no matter which
#  directory it was started from.
#
#  Check what is actually in effect:
#     python backend\scripts\verify_meta.py
#     GET http://localhost:5000/api/v1/ai-agents/health
# =============================================================================


# =============================================================================
#  1. META MODEL API   (primary LLM - powers both agents)
# =============================================================================
# Key issued by the Meta Model API console: https://dev.meta.ai/products/meta-model-api
META_API_KEY = PASTE_YOUR_META_MODEL_API_KEY_HERE

# Muse Spark 1.3 - latest Muse Spark model served by Meta Model API. Used by the
# Audit Agent for compliance verdicts and by the Remediation Agent for plans.
#
# Confirmed available to this key via GET https://api.meta.ai/v1/models:
#   muse-spark-1.3  muse-spark-1.3-contributor
#   muse-spark-1.2  muse-spark-1.2-contributor  muse-spark-1.1
#   muse-wonder-1.0  muse-image-1.0  muse-voice-transcribe-1.0  sam-3.1
#
# NOTE: `muse-spark-open` is NOT served by Meta Model API - it is an open-weights
# model intended to be self-hosted. `meta-models/muse-spark-open-1026` therefore
# returns model_not_found. The hackathon brief covers both routes: Muse Spark via
# the Model API, Muse Spark Open / Muse Glimmer via open weights.
META_MODEL = muse-spark-1.3

# OpenAI-compatible endpoint. The stock `openai` SDK is pointed here.
META_BASE_URL = https://api.meta.ai/v1

# Which provider serves chat completions:
#   meta  -> Meta Model API            (hackathon target)
#   kong  -> Kong AI Gateway          (needs KONG_AI_PROXY_HOSTNAME + KONG_API_KEY)
#   auto  -> Meta when META_API_KEY is set, else Kong
LLM_PROVIDER = meta

# Hard lock for the hackathon: refuse to serve a request from a non-Meta
# provider, even if Kong credentials are present. Set to false only
# if you deliberately want the Kong fallback back.
META_ONLY = true

# Output ceiling per call. Reasoning models count reasoning tokens against this.
LLM_MAX_TOKENS = 8000
LLM_TIMEOUT = 120

# Findings per remediation call. One call for all findings grows with the Kong
# estate and truncates past the token cap, producing invalid JSON.
REMEDIATION_BATCH_SIZE = 5


# =============================================================================
#  2. EMBEDDINGS   (RAG retrieval layer)
# =============================================================================
# Retrieval vectors are deterministic hashed bag-of-words produced locally:
# no external call needed, but they match on shared vocabulary only, NOT on
# paraphrase. All *reasoning* runs on META_MODEL above.


# =============================================================================
#  3. REDIS STACK   (vector database)
# =============================================================================
# Must be Redis Stack / redis-stack-server - the RediSearch module is required.
# Plain `redis` cannot do vector search.
REDIS_HOST = localhost
REDIS_PORT = 6379
# REDIS_PASSWORD =

# Vector index. VECTOR_DIMENSIONS must match the embedding model:
#   text-embedding-3-small = 1536, text-embedding-3-large = 3072
INDEX_NAME = security_auditor_index
KEY_PREFIX = embedding:
VECTOR_DIMENSIONS = 1536

# Policy corpus, relative to backend/
KNOWLEDGE_BASE_DIR = knowledge_base
CHUNK_SIZE = 900
CHUNK_OVERLAP = 120


# =============================================================================
#  4. KONG   (the API estate being audited)
# =============================================================================
# KONG_ADMIN_MODE: auto | konnect | onprem
#   konnect -> Authorization: Bearer <kpat_...>, /core-entities/ paths
#   onprem  -> kong-admin-token header, bare /services paths
# auto detects Konnect from the hostname (api.konghq.com / control-planes).
KONG_ADMIN_MODE = auto
KONG_ADMIN_API =
KONG_ADMIN_TOKEN =

# Konnect serves a valid public certificate, so keep verification on.
# Set false only for a self-managed gateway behind a self-signed cert.
KONG_ADMIN_VERIFY_SSL = true
KONG_PAGE_SIZE = 1000
KONG_HTTP_TIMEOUT = 30


# =============================================================================
#  5. KONG AI GATEWAY   (optional - only when LLM_PROVIDER = kong)
# =============================================================================
# Leave blank to call Meta Model API directly. Set both to route agent LLM
# traffic through Kong AI Gateway.
KONG_AI_PROXY_HOSTNAME =
KONG_API_KEY =


# =============================================================================
#  6. SERVICE PORTS
# =============================================================================
AGENTS_PORT = 5000
KNOWLEDGE_PORT = 5001
REDIS_TEST_PORT = 5002

ADMIN_API_KEYS=admin
OPERATOR_API_KEYS=operator
VIEWER_API_KEYS=viewer