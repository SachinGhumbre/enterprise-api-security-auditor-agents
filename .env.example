# =============================================================================
# Enterprise API Security Auditor - configuration template.
#
# DOCKER (judges / quick start):
#   1. Copy this file:   cp .env.example .env        (Windows: copy .env.example .env)
#   2. Set META_API_KEY below - the ONLY required value.
#   3. Start everything: docker compose up -d --build
#   4. Open http://localhost:3000 and sign in with:  operator / operator
#
# The container mounts this file to /app/backend/.env (read-only) and every
# service - agents, knowledge, harness - reads it from there. It is NEVER
# baked into the image, so keys stay on your machine. This file is gitignored:
# do NOT commit the filled-in .env.
#
# LOCAL DEV (no Docker): copy the backend sections (1-6) to backend/.env and
# the dashboard section (7) to frontend/.env instead (see README).
# =============================================================================


# =============================================================================
# 1. META MODEL API   (REQUIRED - powers audit, remediation and assistant)
# =============================================================================
# Key issued by the Meta Model API console:
# https://dev.meta.ai/products/meta-model-api
# Without it the dashboard and knowledge search still work, but every LLM
# call fails - the container logs a warning and keeps running.
META_API_KEY =

# Muse Spark 1.3 - latest Muse Spark model served by Meta Model API.
META_MODEL = muse-spark-1.3

# OpenAI-compatible endpoint. The stock `openai` SDK is pointed here.
META_BASE_URL = https://api.meta.ai/v1

# meta | kong | auto  (meta is the hackathon target)
LLM_PROVIDER = meta

# Hard lock: refuse to serve a request from a non-Meta provider.
META_ONLY = true

# Output ceiling per call. Reasoning models count reasoning tokens against this.
LLM_MAX_TOKENS = 8000
LLM_TIMEOUT = 120

# Findings per remediation call. One call for all findings grows with the Kong
# estate and truncates past the token cap, producing invalid JSON.
REMEDIATION_BATCH_SIZE = 5


# =============================================================================
# 2. REDIS STACK   (vector database - runs INSIDE the container in Docker)
# =============================================================================
# Leave 127.0.0.1 for Docker: the image bundles redis-stack-server and the
# APIs talk to it over container loopback. Point at your own host only for
# local dev without Docker (must be Redis Stack - plain redis has no
# RediSearch module and vector search will not work).
REDIS_HOST = 127.0.0.1
REDIS_PORT = 6379
# REDIS_PASSWORD =
# REDIS_USERNAME =

# Vector index. VECTOR_DIMENSIONS must match the embedding model:
#   text-embedding-3-small = 1536, text-embedding-3-large = 3072
INDEX_NAME = security_auditor_index
KEY_PREFIX = embedding:
VECTOR_DIMENSIONS = 1536

# Policy corpus, relative to backend/
KNOWLEDGE_BASE_DIR = knowledge_base
CHUNK_SIZE = 900
CHUNK_OVERLAP = 120


# =============================================================================
# 3. KONG   (OPTIONAL - the API estate being audited)
# =============================================================================
# Leave blank to audit the bundled sample inventory instead (audits still run
# end to end and report kong_source: cached_file). To audit a live estate:
# Konnect: KONG_ADMIN_API = https://<geo>.api.konghq.com/v2/control-planes/<id>
#          KONG_ADMIN_TOKEN = kpat_...
# KONG_ADMIN_MODE: auto | konnect | onprem
KONG_ADMIN_MODE = auto
KONG_ADMIN_API =
KONG_ADMIN_TOKEN =

# Konnect serves a valid public certificate, so keep verification on.
# Set false only for a self-managed gateway behind a self-signed cert.
KONG_ADMIN_VERIFY_SSL = true
KONG_PAGE_SIZE = 1000
KONG_HTTP_TIMEOUT = 30


# =============================================================================
# 4. KONG AI GATEWAY   (optional - only when LLM_PROVIDER = kong)
# =============================================================================
# Leave blank to call Meta Model API directly. Set both to route agent LLM
# traffic through Kong AI Gateway.
KONG_AI_PROXY_HOSTNAME =
KONG_API_KEY =


# =============================================================================
# 5. SERVICE PORTS   (must match the ports in docker-compose.yml)
# =============================================================================
AGENTS_PORT = 5000
KNOWLEDGE_PORT = 5001
REDIS_TEST_PORT = 5002


# =============================================================================
# 6. API AUTH   (demo keys - the dashboard keys in section 7 must match these)
# =============================================================================
# Comma-separated lists. Full access / run+approve / read-only.
ADMIN_API_KEYS = admin
OPERATOR_API_KEYS = operator
VIEWER_API_KEYS = viewer
# ALLOWED_ORIGINS =   (unset means CORS allows *)


# =============================================================================
# 7. DASHBOARD LOGIN   (used by the React UI at http://localhost:3000)
# =============================================================================
# Usernames are fixed (admin / operator / viewer). Passwords are shown on the
# login page; each account maps to the role API key below, which MUST match
# section 6. In Docker these are injected at container startup - changing them
# needs only a container restart, never a rebuild.
REACT_APP_ADMIN_PASSWORD = admin
REACT_APP_OPERATOR_PASSWORD = operator
REACT_APP_VIEWER_PASSWORD = viewer
REACT_APP_ADMIN_KEY = admin
REACT_APP_OPERATOR_KEY = operator
REACT_APP_VIEWER_KEY = viewer
# Optional endpoint overrides (defaults are the localhost ports below).
# REACT_APP_AGENTS_URL = http://localhost:5000
# REACT_APP_KNOWLEDGE_URL = http://localhost:5001
# REACT_APP_REDIS_TEST_URL = http://localhost:5002
