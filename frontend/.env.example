# Demo login for the dashboard (this file is gitignored).
# Passwords are shown on the login page; each account maps to the role API key
# below, which must match backend/.env. Use throwaway keys for demos.
REACT_APP_ADMIN_PASSWORD=Admin@123
REACT_APP_OPERATOR_PASSWORD=Operator@123
REACT_APP_VIEWER_PASSWORD=Viewer@123
REACT_APP_ADMIN_KEY=paste-admin-key-from-backend-env
REACT_APP_OPERATOR_KEY=paste-operator-key-from-backend-env
REACT_APP_VIEWER_KEY=paste-viewer-key-from-backend-env
