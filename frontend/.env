# Demo login for the dashboard (this file is gitignored).
# Passwords are shown on the login page; each account maps to the role API key
# below, which must match backend/.env. Use throwaway keys for demos.

REACT_APP_ADMIN_PASSWORD=admin
REACT_APP_OPERATOR_PASSWORD=operator
REACT_APP_VIEWER_PASSWORD=viewer

REACT_APP_ADMIN_KEY=admin
REACT_APP_OPERATOR_KEY=operator
REACT_APP_VIEWER_KEY=viewer
